    <string name="action_retouch">Retoucher l\'assemblage</string>
    <string name="retouch_title">Retoucher l\'assemblage</string>
    <string name="retouch_intro">Les photos de la capture sont conservées : la sphère peut être réassemblée autrement, autant de fois que nécessaire. Le résultat remplace la sphère actuelle, en gardant son nom, ses portails et sa vue d\'entrée.</string>
    <string name="retouch_align_title">Alignement</string>
    <string name="retouch_align_sensors">Depuis les capteurs (rapide, aboutit toujours)</string>
    <string name="retouch_align_features">Recaler sur les points d\'intérêt (1 à 2 min)</string>
    <string name="retouch_align_note">Le recalage corrige les erreurs de focale et les petits déplacements, mais échoue sur murs unis ou en faible lumière : la sphère actuelle est alors conservée.</string>
    <string name="retouch_width_title">Résolution</string>
    <string name="retouch_width">%1$d × %2$d px</string>
    <string name="retouch_width_note">Au-delà de 4096, l\'affichage demande plus de mémoire au téléphone et le gain dépend de la netteté des photos d\'origine.</string>
    <string name="retouch_blend_title">Raccords</string>
    <string name="retouch_blend_soft">Doux — dilue les écarts de lumière</string>
    <string name="retouch_blend_balanced">Équilibré — réglage par défaut</string>
    <string name="retouch_blend_crisp">Francs — contours plus nets</string>
    <string name="retouch_shots_title">Photos utilisées</string>
    <string name="retouch_shots_note">Touche une photo pour l\'écarter. Une prise floue ou faite en marchant abîme la zone qu\'elle couvre ; sans elle, ses voisines la remplacent.</string>
    <string name="retouch_shots_count">%1$d photo(s) sur %2$d</string>
