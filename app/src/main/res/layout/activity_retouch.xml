<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:minHeight="@dimen/toolbar_height"
        android:navigationIcon="@drawable/ic_arrow_back"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:title="@string/retouch_title"
        android:titleTextAppearance="@style/Text.Title" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="@string/retouch_intro"
                android:textAppearance="@style/Text.Caption" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/retouch_align_title"
                android:textAppearance="@style/Text.Title"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/group_align"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/align_sensors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/retouch_align_sensors"
                    android:textAppearance="@style/Text.Body" />

                <RadioButton
                    android:id="@+id/align_features"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/retouch_align_features"
                    android:textAppearance="@style/Text.Body" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="@string/retouch_align_note"
                android:textAppearance="@style/Text.Caption" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/retouch_width_title"
                android:textAppearance="@style/Text.Title"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/group_width"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="@string/retouch_width_note"
                android:textAppearance="@style/Text.Caption" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/retouch_blend_title"
                android:textAppearance="@style/Text.Title"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/group_blend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/blend_soft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/retouch_blend_soft"
                    android:textAppearance="@style/Text.Body" />

                <RadioButton
                    android:id="@+id/blend_balanced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/retouch_blend_balanced"
                    android:textAppearance="@style/Text.Body" />

                <RadioButton
                    android:id="@+id/blend_crisp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/retouch_blend_crisp"
                    android:textAppearance="@style/Text.Body" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/retouch_shots_title"
                android:textAppearance="@style/Text.Title"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/shots_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/Text.Caption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/retouch_shots_note"
                android:textAppearance="@style/Text.Caption" />

            <LinearLayout
                android:id="@+id/shots_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btn_run"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/retouch_run" />
    </LinearLayout>
</LinearLayout>
