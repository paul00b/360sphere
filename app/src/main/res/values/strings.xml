    <!-- Retouche : assiette et réassemblage -->
    <string name="level_menu">Redresser la sphère</string>
    <string name="level_title">Assiette de la sphère</string>
    <string name="level_body">Corrige un horizon penché. La rotation est appliquée à l\'affichage, sans réassembler l\'image, et les portails suivent le décor.</string>
    <string name="level_tilt">Inclinaison avant/arrière : %1$s°</string>
