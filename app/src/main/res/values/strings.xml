    <string name="menu_about">À propos</string>
    <string name="about_title">Sphère 360</string>
    <string name="about_body">Capture guidée de photos sphériques et visite virtuelle.\n\nAssemblage : OpenCV Stitcher (via JavaCPP).\nVisualisation : Photo Sphere Viewer.\n\nLimites connues : voir le README du projet.</string>
    <string name="notification_permission_hint">Autorise les notifications pour suivre l\'assemblage quand l\'app est en arrière-plan.</string>

    <!-- Capture -->
    <string name="capture_intro_title">Capture guidée</string>
    <string name="capture_intro_body">Reste sur place et pivote sur toi-même, sans te déplacer. Garde le téléphone proche du corps et amène le cercle sur chaque point : la photo se prend toute seule quand tu es aligné et immobile.</string>
    <string name="capture_intro_tip">Astuce : commence face à la zone la plus représentative en luminosité, l\'exposition est verrouillée au départ pour éviter les raccords visibles.</string>
    <string name="capture_progress">%1$d / %2$d</string>
    <string name="capture_hint_aim">Amène le cercle sur le point</string>
    <string name="capture_hint_hold">Ne bouge plus…</string>
    <string name="capture_hint_turn">Tourne vers la flèche</string>
    <string name="capture_hint_done">Capture terminée, assemblage lancé</string>
    <string name="capture_hint_saving">Photo enregistrée</string>
    <string name="capture_cancel_title">Abandonner la capture ?</string>
    <string name="capture_cancel_body">Les %1$d photos déjà prises seront perdues.</string>
    <string name="capture_cancel_confirm">Abandonner</string>
    <string name="capture_finish_early_title">Terminer maintenant ?</string>
    <string name="capture_finish_early_body">Il manque %1$d positions : la sphère aura des zones vides. Tu peux aussi continuer pour la compléter.</string>
    <string name="capture_finish_now">Terminer quand même</string>
